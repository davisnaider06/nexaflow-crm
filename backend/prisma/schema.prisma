generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // Configurado no .env
}

model Funcionario {
  id           Int             @id @default(autoincrement())
  nome         String
  time         String          // "prospecao", "vendas", "tecnico"
  atendimentos Atendimento[]
}

model Cliente {
  id           Int             @id @default(autoincrement())
  nome         String
  contato      String
  origem       String          // "WhatsApp", "Email", etc.
  atendimentos Atendimento[]
}

model Atendimento {
  id            Int            @id @default(autoincrement())
  funcionario   Funcionario    @relation(fields: [funcionarioId], references: [id])
  funcionarioId Int
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  clienteId     Int
  data          DateTime       @default(now())
  status        String         // "prospectado", "vendido", "em_andamento"
  origem        String         // Canal de contato (omnichannel)
}