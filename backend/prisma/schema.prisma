// Defininr a conexão com o banco de dados
datasource db {
  provider = "postgresql"       // Tipo de banco (PostgreSQL, MySQL, etc.)
  url      = env("DATABASE_URL") // Variável do arquivo .env
}

model Funcionario {
  id           Int           @id @default(autoincrement())
  nome         String
  time         String        // "prospecao", "vendas", "tecnico"
  atendimentos Atendimento[] // Relação 1-N
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  contato      String
  origem       String        // "whatsApp", "email", etc.
  atendimentos Atendimento[] // Relação 1-N
}

model Atendimento {
  id            Int         @id @default(autoincrement())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  funcionarioId Int
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  clienteId     Int
  status        String
  origem        String
  data          DateTime    @default(now())
}